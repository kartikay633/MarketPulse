# ============================================
# MARKET PULSE — Environment Variables
# Copy this file to .env and fill in your credentials
# ============================================

# ---- DATABASE ----
DATABASE_URL=postgresql://marketpulse:marketpulse_dev@localhost:5432/marketpulse
DB_POOL_MIN=2
DB_POOL_MAX=10

# ---- SUPABASE AUTH ----
# Public (safe for frontend — prefixed with VITE_)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Private (backend only — NEVER expose to frontend)
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- UPSTOX ----
UPSTOX_ANALYTICS_TOKEN=your-analytics-token
UPSTOX_API_BASE_URL=https://api.upstox.com/v2

# ---- AI (Google Gemini) ----
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# ---- NEWS ----
NEWS_API_KEY=your-marketaux-api-key
NEWS_API_BASE_URL=https://api.marketaux.com/v1

# ---- APPLICATION ----
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---- LOGGING ----
LOG_LEVEL=info
